# 실제 인증 정보는 server/.env에 설정합니다.
NODE_ENV=development
PORT=3000
# 전체 환경의 기본 바인드 주소는 127.0.0.1입니다.
# 로컬에서 기기 테스트 등 외부 접속이 필요한 경우에만 HOST=0.0.0.0을 지정합니다.
CLIENT_URL=http://localhost:3001

# 예: postgresql://<user>:<password>@localhost:5432/worshiplog
DATABASE_URL=
REDIS_URL=

# 서로 다른 값을 생성합니다. 예: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

RESEND_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# 운영에서는 nginx와 같은 절대 저장 경로 및 공개 URL을 설정합니다.
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_URL=http://localhost:3000/uploads
